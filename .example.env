DATABASE_USERNAME="stability"
DATABASE_PASSWORD="stabilisite"
DATABASE_URL="localhost:5432/stability"

DISCORD_BOT_API_TOKEN=token
DISCORD_BOT_API="localhost:8000/v1"
# Comma-separated keys clients must send in the X-API-Key header. Unset disables the check.
API_KEYS=

# Trial board: backend owns PostgreSQL state; disabled and paused by default.
TRIAL_BOARD_ENABLED=false
# Separate server-only credential, also configured in Stabilibot; never browser JS.
TRIAL_BOARD_API_KEY=
TRIAL_BOARD_GUILD_ID=0
TRIAL_BOARD_QUEUE_CHANNEL_ID=0
TRIAL_BOARD_STAFF_CHANNEL_ID=0
# Comma-separated IDs; staff and volunteer role lists must be disjoint.
TRIAL_BOARD_STAFF_ROLE_IDS=
TRIAL_BOARD_VOLUNTEER_ROLE_IDS=
TRIAL_BOARD_SHARED_POOL=true
TRIAL_BOARD_OFFER_LIMIT=3
TRIAL_BOARD_TRIAL_DAYS=14
